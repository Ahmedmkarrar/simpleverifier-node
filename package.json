{
  "name": "simpleverifier",
  "version": "0.1.0",
  "description": "Official Node.js client for the SimpleVerifier email verification and phone validation API.",
  "keywords": [
    "email verification",
    "email validation",
    "verify email",
    "email verifier",
    "email checker",
    "validate email",
    "smtp check",
    "mailbox check",
    "bounce",
    "email bounce",
    "disposable email",
    "phone validation",
    "phone number validation",
    "phone lookup",
    "carrier lookup",
    "e164",
    "simpleverifier",
    "api client",
    "sdk"
  ],
  "homepage": "https://simpleverifier.com/docs/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmedmkarrar/simpleverifier-node.git"
  },
  "bugs": {
    "url": "https://github.com/Ahmedmkarrar/simpleverifier-node/issues",
    "email": "support@simpleverifier.com"
  },
  "author": "SimpleVerifier Team <support@simpleverifier.com> (https://simpleverifier.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "tsup"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
